    rr:logicalTable [ rr:tableName "opportunities" ] ;
    rr:subjectMap [ rr:template "http://revops.org/ontology#opportunity/{deal_id}" ; rr:class :Opportunity ] ;
    rr:predicateObjectMap [
        rr:predicate :account_id ;
        rr:objectMap [ rr:column "account_id" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate :deal_name ;
        rr:objectMap [ rr:column "deal_name" ]
    ] ;
    rr:predicateObjectMap [
