        rr:objectMap [ rr:column "first_name" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate :last_name ;
        rr:objectMap [ rr:column "last_name" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate :title ;
        rr:objectMap [ rr:column "title" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate :role ;
        rr:objectMap [ rr:column "role" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate :is_primary ;
        rr:objectMap [ rr:column "is_primary" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate :status ;
        rr:objectMap [ rr:column "status" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate :created_at ;
        rr:objectMap [ rr:column "created_at" ]
    ] .

