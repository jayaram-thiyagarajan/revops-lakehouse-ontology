@prefix revops: <http://revops.org/ontology#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .

<http://revops.org/ontology##AccountMap> rr:logicalTable [ rr:tableName "accounts" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:column "name" ] ;
            rr:predicate revops:name ],
        [ rr:objectMap [ rr:column "num_employees" ] ;
            rr:predicate revops:num_employees ],
        [ rr:objectMap [ rr:column "tier" ] ;
            rr:predicate revops:tier ],
        [ rr:objectMap [ rr:column "industry" ] ;
            rr:predicate revops:industry ],
        [ rr:objectMap [ rr:column "created_at" ] ;
            rr:predicate revops:created_at ],
        [ rr:objectMap [ rr:column "domain" ] ;
            rr:predicate revops:domain ],
        [ rr:objectMap [ rr:column "health_score" ] ;
            rr:predicate revops:health_score ],
        [ rr:objectMap [ rr:column "lifecycle_stage" ] ;
            rr:predicate revops:lifecycle_stage ],
        [ rr:objectMap [ rr:column "arr" ] ;
            rr:predicate revops:arr ] ;
    rr:subjectMap [ rr:class revops:Account ;
            rr:template "http://revops.org/ontology#account/{account_id}" ] .

<http://revops.org/ontology##CampaignDailyCostMap> rr:logicalTable [ rr:tableName "campaign_daily_costs" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:column "cost" ] ;
            rr:predicate revops:cost ],
        [ rr:objectMap [ rr:column "created_at" ] ;
            rr:predicate revops:created_at ],
        [ rr:objectMap [ rr:column "date" ] ;
            rr:predicate revops:date ],
        [ rr:objectMap [ rr:column "clicks" ] ;
            rr:predicate revops:clicks ],
        [ rr:objectMap [ rr:column "campaign_id" ] ;
            rr:predicate revops:campaign_id ],
        [ rr:objectMap [ rr:column "impressions" ] ;
            rr:predicate revops:impressions ] ;
    rr:subjectMap [ rr:class revops:CampaignDailyCost ;
            rr:template "http://revops.org/ontology#campaigndailycost/{cost_id}" ] .

<http://revops.org/ontology##CampaignMap> rr:logicalTable [ rr:tableName "campaigns" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:column "start_date" ] ;
            rr:predicate revops:start_date ],
        [ rr:objectMap [ rr:column "name" ] ;
            rr:predicate revops:name ],
        [ rr:objectMap [ rr:column "budget" ] ;
            rr:predicate revops:budget ],
        [ rr:objectMap [ rr:column "channel" ] ;
            rr:predicate revops:channel ],
        [ rr:objectMap [ rr:column "created_at" ] ;
            rr:predicate revops:created_at ],
        [ rr:objectMap [ rr:column "type" ] ;
            rr:predicate revops:type ],
        [ rr:objectMap [ rr:column "status" ] ;
            rr:predicate revops:status ],
        [ rr:objectMap [ rr:column "end_date" ] ;
            rr:predicate revops:end_date ] ;
    rr:subjectMap [ rr:class revops:Campaign ;
            rr:template "http://revops.org/ontology#campaign/{campaign_id}" ] .

<http://revops.org/ontology##CampaignTouchMap> rr:logicalTable [ rr:tableName "campaign_touches" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:column "contact_id" ] ;
            rr:predicate revops:contact_id ],
        [ rr:objectMap [ rr:column "touch_type" ] ;
            rr:predicate revops:touch_type ],
        [ rr:objectMap [ rr:column "touch_time" ] ;
            rr:predicate revops:touch_time ],
        [ rr:objectMap [ rr:column "channel" ] ;
            rr:predicate revops:channel ],
        [ rr:objectMap [ rr:column "campaign_id" ] ;
            rr:predicate revops:campaign_id ] ;
    rr:subjectMap [ rr:class revops:CampaignTouch ;
            rr:template "http://revops.org/ontology#campaigntouch/{touch_id}" ] .

<http://revops.org/ontology##ContactMap> rr:logicalTable [ rr:tableName "contacts" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:column "title" ] ;
            rr:predicate revops:title ],
        [ rr:objectMap [ rr:column "last_name" ] ;
            rr:predicate revops:last_name ],
        [ rr:objectMap [ rr:column "account_id" ] ;
            rr:predicate revops:account_id ],
        [ rr:objectMap [ rr:column "is_primary" ] ;
            rr:predicate revops:is_primary ],
        [ rr:objectMap [ rr:column "first_name" ] ;
            rr:predicate revops:first_name ],
        [ rr:objectMap [ rr:column "email" ] ;
            rr:predicate revops:email ],
        [ rr:objectMap [ rr:column "status" ] ;
            rr:predicate revops:status ],
        [ rr:objectMap [ rr:column "created_at" ] ;
            rr:predicate revops:created_at ],
        [ rr:objectMap [ rr:column "role" ] ;
            rr:predicate revops:role ] ;
    rr:subjectMap [ rr:class revops:Contact ;
            rr:template "http://revops.org/ontology#contact/{contact_id}" ] .

<http://revops.org/ontology##EnterpriseAccountMap> rr:logicalTable [ rr:sqlQuery "SELECT * FROM accounts WHERE tier = 'Enterprise'" ] ;
    rr:subjectMap [ rr:class revops:EnterpriseAccount ;
            rr:template "http://revops.org/ontology#account/{account_id}" ] .

<http://revops.org/ontology##ExpansionDealMap> rr:logicalTable [ rr:sqlQuery "SELECT * FROM opportunities WHERE deal_type = 'Expansion'" ] ;
    rr:subjectMap [ rr:class revops:ExpansionDeal ;
            rr:template "http://revops.org/ontology#opportunity/{deal_id}" ] .

<http://revops.org/ontology##MidMarketAccountMap> rr:logicalTable [ rr:sqlQuery "SELECT * FROM accounts WHERE tier = 'Mid-Market'" ] ;
    rr:subjectMap [ rr:class revops:MidMarketAccount ;
            rr:template "http://revops.org/ontology#account/{account_id}" ] .

<http://revops.org/ontology##NewBusinessDealMap> rr:logicalTable [ rr:sqlQuery "SELECT * FROM opportunities WHERE deal_type = 'New Business'" ] ;
    rr:subjectMap [ rr:class revops:NewBusinessDeal ;
            rr:template "http://revops.org/ontology#opportunity/{deal_id}" ] .

<http://revops.org/ontology##OpenExpansionDealMap> rr:logicalTable [ rr:sqlQuery "SELECT * FROM opportunities WHERE deal_type = 'Expansion' AND is_closed = false" ] ;
    rr:subjectMap [ rr:class revops:OpenExpansionDeal ;
            rr:template "http://revops.org/ontology#opportunity/{deal_id}" ] .

<http://revops.org/ontology##OpportunityMap> rr:logicalTable [ rr:tableName "opportunities" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:column "created_at" ] ;
            rr:predicate revops:created_at ],
        [ rr:objectMap [ rr:column "close_date" ] ;
            rr:predicate revops:close_date ],
        [ rr:objectMap [ rr:column "is_won" ] ;
            rr:predicate revops:is_won ],
        [ rr:objectMap [ rr:column "stage" ] ;
            rr:predicate revops:stage ],
        [ rr:objectMap [ rr:column "deal_type" ] ;
            rr:predicate revops:deal_type ],
        [ rr:objectMap [ rr:column "account_id" ] ;
            rr:predicate revops:account_id ],
        [ rr:objectMap [ rr:column "deal_name" ] ;
            rr:predicate revops:deal_name ],
        [ rr:objectMap [ rr:column "amount" ] ;
            rr:predicate revops:amount ],
        [ rr:objectMap [ rr:column "is_closed" ] ;
            rr:predicate revops:is_closed ] ;
    rr:subjectMap [ rr:class revops:Opportunity ;
            rr:template "http://revops.org/ontology#opportunity/{deal_id}" ] .

<http://revops.org/ontology##ProductEventMap> rr:logicalTable [ rr:tableName "product_events" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:column "session_duration_seconds" ] ;
            rr:predicate revops:session_duration_seconds ],
        [ rr:objectMap [ rr:column "event_name" ] ;
            rr:predicate revops:event_name ],
        [ rr:objectMap [ rr:column "user_id" ] ;
            rr:predicate revops:user_id ],
        [ rr:objectMap [ rr:column "feature_name" ] ;
            rr:predicate revops:feature_name ],
        [ rr:objectMap [ rr:column "account_id" ] ;
            rr:predicate revops:account_id ],
        [ rr:objectMap [ rr:column "event_time" ] ;
            rr:predicate revops:event_time ] ;
    rr:subjectMap [ rr:class revops:ProductEvent ;
            rr:template "http://revops.org/ontology#productevent/{event_id}" ] .

<http://revops.org/ontology##RenewalDealMap> rr:logicalTable [ rr:sqlQuery "SELECT * FROM opportunities WHERE deal_type = 'Renewal'" ] ;
    rr:subjectMap [ rr:class revops:RenewalDeal ;
            rr:template "http://revops.org/ontology#opportunity/{deal_id}" ] .

<http://revops.org/ontology##SMBAccountMap> rr:logicalTable [ rr:sqlQuery "SELECT * FROM accounts WHERE tier = 'SMB'" ] ;
    rr:subjectMap [ rr:class revops:SMBAccount ;
            rr:template "http://revops.org/ontology#account/{account_id}" ] .

<http://revops.org/ontology##attributedToCampaignMap> rr:logicalTable [ rr:sqlQuery "SELECT campaign_touches.touch_id, campaigns.campaign_id FROM campaign_touches JOIN campaigns ON campaign_touches.campaign_id = campaigns.campaign_id" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:template "http://revops.org/ontology#campaign/{campaign_id}" ] ;
            rr:predicate revops:attributedToCampaign ] ;
    rr:subjectMap [ rr:template "http://revops.org/ontology#campaigntouch/{touch_id}" ] .

<http://revops.org/ontology##hasContactMap> rr:logicalTable [ rr:sqlQuery "SELECT accounts.account_id, contacts.contact_id FROM accounts JOIN contacts ON accounts.account_id = contacts.account_id" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:template "http://revops.org/ontology#contact/{contact_id}" ] ;
            rr:predicate revops:hasContact ] ;
    rr:subjectMap [ rr:template "http://revops.org/ontology#account/{account_id}" ] .

<http://revops.org/ontology##hasOpportunityMap> rr:logicalTable [ rr:sqlQuery "SELECT accounts.account_id, opportunities.deal_id FROM accounts JOIN opportunities ON accounts.account_id = opportunities.account_id" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:template "http://revops.org/ontology#opportunity/{deal_id}" ] ;
            rr:predicate revops:hasOpportunity ] ;
    rr:subjectMap [ rr:template "http://revops.org/ontology#account/{account_id}" ] .

<http://revops.org/ontology##hasTelemetryEventMap> rr:logicalTable [ rr:sqlQuery "SELECT accounts.account_id, product_events.event_id FROM accounts JOIN product_events ON accounts.account_id = product_events.account_id" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:template "http://revops.org/ontology#productevent/{event_id}" ] ;
            rr:predicate revops:hasTelemetryEvent ] ;
    rr:subjectMap [ rr:template "http://revops.org/ontology#account/{account_id}" ] .

<http://revops.org/ontology##hasTouchpointMap> rr:logicalTable [ rr:sqlQuery "SELECT contacts.contact_id, campaign_touches.touch_id FROM contacts JOIN campaign_touches ON contacts.contact_id = campaign_touches.contact_id" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:template "http://revops.org/ontology#campaigntouch/{touch_id}" ] ;
            rr:predicate revops:hasTouchpoint ] ;
    rr:subjectMap [ rr:template "http://revops.org/ontology#contact/{contact_id}" ] .

<http://revops.org/ontology##tracksDailyCostMap> rr:logicalTable [ rr:sqlQuery "SELECT campaigns.campaign_id, campaign_daily_costs.cost_id FROM campaigns JOIN campaign_daily_costs ON campaigns.campaign_id = campaign_daily_costs.campaign_id" ] ;
    rr:predicateObjectMap [ rr:objectMap [ rr:template "http://revops.org/ontology#campaigndailycost/{cost_id}" ] ;
            rr:predicate revops:tracksDailyCost ] ;
    rr:subjectMap [ rr:template "http://revops.org/ontology#campaign/{campaign_id}" ] .

