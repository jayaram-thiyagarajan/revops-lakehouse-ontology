@prefix : <http://revops.org/ontology#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<#AccountMap>
    rr:logicalTable [ rr:tableName "accounts" ] ;
    rr:subjectMap [ rr:template "http://revops.org/ontology#account/{account_id}" ; rr:class :Account ] ;
    rr:predicateObjectMap [
        rr:predicate :name ;
        rr:objectMap [ rr:column "name" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate :domain ;
        rr:objectMap [ rr:column "domain" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate :tier ;
        rr:objectMap [ rr:column "tier" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate :industry ;
        rr:objectMap [ rr:column "industry" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate :arr ;
        rr:objectMap [ rr:column "arr" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate :health_score ;
        rr:objectMap [ rr:column "health_score" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate :lifecycle_stage ;
        rr:objectMap [ rr:column "lifecycle_stage" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate :num_employees ;
        rr:objectMap [ rr:column "num_employees" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate :created_at ;
        rr:objectMap [ rr:column "created_at" ]
    ] .

<#ContactMap>
    rr:logicalTable [ rr:tableName "contacts" ] ;
